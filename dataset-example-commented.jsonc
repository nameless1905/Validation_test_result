// =====================================================================
// ПРИМЕР SFT-ОБУЧАЮЩЕГО ПРИМЕРА С ПОДРОБНЫМИ КОММЕНТАРИЯМИ
// Формат: JSONC (JSON with Comments) — используется только для чтения/
// документации. Для загрузки в пайплайн обучения нужна версия БЕЗ
// комментариев (см. файл dataset-example-clean.json).
// =====================================================================

{
  "messages": [

    // system-сообщение — задаёт роль модели и формат ответа.
    // Одинаковое для всех примеров в датасете, не меняется от кейса к кейсу.
    {
      "role": "system",
      "content": "Ты — ассистент верификации результатов общего анализа крови. Проанализируй результат по шагам: пороговые значения → дельта-чек → флаги анализатора и морфология → соответствие клиническому контексту → итоговое решение (auto_pass / manual_review / smear_review_required)."
    },

    // user-сообщение — это ВХОД модели. В реальном датасете это строка
    // (сериализованный JSON), а не вложенный объект — здесь он показан
    // в развёрнутом виде для читаемости комментариев.
    {
      "role": "user",
      "content": {

        // Уникальный идентификатор кейса в вашем ML-датасете.
        // НЕ равен id из таблиц ЛИС (measurecontext.id и т.п.) —
        // генерируется отдельно, чтобы не палить внутренние PK источника.
        "case_id": "004-058345",

        // Момент создания ЗАПИСИ в ML-системе (не момент забора крови —
        // для этого есть collected_at ниже). Обычно = момент выгрузки
        // из ЛИС в витрину.
        "created_at": "2026-07-14T09:12:00Z",

        // Название/код исходной ЛИС. Полезно, если данные когда-нибудь
        // будут собираться из нескольких систем (например, при слиянии
        // лабораторных сетей) — позволяет отличить источник.
        "source_lis": "Genesis",

        "analyzer": {
          // Модель гематологического анализатора.
          // Источник: analyser.name в вашей ЛИС (через method.analyser_id).
          // ВАЖНО: в БД это просто текстовое поле, разные записи могут
          // содержать разное написание одной и той же модели —
          // нормализуйте на этапе ETL (справочник dim_analyzer).
          "model": "Mindray CAL8000",

          // Партия реагентов, ХЭШИРОВАННАЯ (не сырой номер лота).
          // Источник: reagentlots.lotnumber, связь через
          // method.reagent_id → reagents.id → reagentlots.reagent_id.
          // Нужна не для идентификации пациента, а для отслеживания
          // системных сдвигов результатов при смене партии реагента.
          "reagent_lot": "a1f9c3e2",

          // Идентификатор конкретного прогона на анализаторе.
          // Источник: automate_event — НО прямой связи automate_event
          // с measurecontext в схеме ЛИС нет, связывать нужно по
          // (samplenumber + workplacecode + временное окно).
          // Это ТЕХНИЧЕСКИЙ ДОЛГ ETL, который надо решить отдельно.
          "run_id": "RUN-20260714-0871"
        },

        "patient_context": {

          // Необратимо обезличенный идентификатор пациента.
          // Источник: hash(patients.id + соль), где patients.id —
          // КАНОНИЧЕСКИЙ id пациента (не orders.id — один пациент
          // может иметь много заказов, и не sample.subjectXxx —
          // это лишь снапшот ФИО на момент забора).
          "patient_pseudo_id": "p_7e2a9c4f1b",

          // Возраст в годах на момент забора крови.
          // Источник: patients.birthdate (или orders.birthdate /
          // sample.subjectbirthdate — в ЛИС это ТРИ разных поля,
          // которые теоретически могут расходиться; канонический
          // источник — patients.birthdate).
          "age_years": 59,

          // Огрублённая возрастная категория — используется вместо
          // точного возраста там, где это возможно, для снижения
          // риска реидентификации редких возрастных групп.
          "age_category": "adult",

          // Пол пациента. Источник: patients.gender (int-код,
          // нужен словарь расшифровки — в ЛИС это INTEGER, не текст).
          // ВНИМАНИЕ: в orders.sex и sample.subjectgender есть
          // дублирующие поля, которые могут расходиться с
          // patients.gender — расхождение стоит логировать отдельно
          // как возможный сигнал ошибки идентификации пробы.
          "sex": "F",

          // === КРИТИЧЕСКИ ВАЖНЫЙ БЛОК ===
          // В вашей ЛИС НЕТ поля клинического диагноза для обычных
          // заказов (единственное поле diagnosis во всей базе — в
          // таблице histologyreferrals, и оно НЕ относится к CBC).
          // Поэтому эти три поля намеренно = null, а не пустая
          // строка/массив — это отличает "система не хранит такие
          // данные вообще" от "у конкретного пациента данные пустые".
          "clinical_diagnosis_codes": null,
          "clinical_diagnosis_text": null,
          "treatment_phase": null,

          // Явный технический флаг для модели и для будущего аудита:
          // объясняет, ПОЧЕМУ поля выше пустые — это ограничение
          // источника данных, а не отсутствие информации у конкретного
          // пациента. Не входит в оригинальную схему case, добавлено
          // специально под ограничения вашей ЛИС.
          "diagnosis_context_availability": "not_tracked_by_source_system",

          // Тип отделения/точки, где выполнен заказ.
          // Источник: частично из orders.origin / department.category —
          // но в коммерческой лабораторной сети это скорее "тип точки
          // приёма" (розница/партнёрская клиника), чем клиническое
          // "отделение стационара", как в больничной ЛИС.
          "ward_type": "outpatient"
        },

        "current_result": {

          // Момент ЗАБОРА крови (не готовности результата!).
          // Источник: sample.samplingtimestamp — НЕ
          // orderline.completiontimestamp (это момент завершения
          // строки заказа, другое событие).
          "collected_at": "2026-07-14T09:09:38Z",

          //наименование исследования
          "assay_name":"Общий анализ крови с формулой",

          // Показатели Исследования. Каждый ключ — код показателя (WBC, PLT...).
          // Источник: одна строка measurecontext = один показатель;
          // код показателя — measureparameter.code/shortname через
          // measureparameter_id. В ЛИС может быть кириллическое или
          // непоследовательное написание — нормализуйте в справочнике
          // dim_measureparameter на этапе ETL.
          "assay_parameters": {

            // MCHC — средняя концентрация гемоглобина в эритроците.
            // value/unit/ref_range — из measurecontext.numericvalue,
            // measuringunit_id → measuringunits.name,
            // normalminvalue/normalmaxvalue.
            // flag — расшифровка measurecontext.resultrefcharstatus +
            // lessflag/moreflag (коды числовые в БД, нужен словарь —
            // расшифровка кодов НЕ найдена в дампе структуры, только
            // в коде приложения или в enum-таблицах, которые нужно
            // выгрузить отдельно).
            "MCHC": {"value": 32.2, "unit": "g/dL", "ref_range": [30.0, 38.0], "flag": null},

            "WBC": {"value": 6.06, "unit": "10^9/L", "ref_range": [4.0, 10.0], "flag": null},
            "NEUT_abs": {"value": 3.87, "unit": "10^9/L", "ref_range": [1.80, 7.70], "flag": null},

            // flag: "L" (low) — ниже нормы. Соответствует
            // measurecontext.lessflag = true в исходной ЛИС.
            "PLT": {"value": 102, "unit": "10^9/L", "ref_range": [180, 320], "flag": "L"},

            // flag: "H" (high) — выше нормы. Соответствует
            // measurecontext.moreflag = true.
            "MPV": {"value": 12.5, "unit": "fL", "ref_range": [9.40, 12.40], "flag": "H"},

            "PDW": {"value": 16.7, "unit": "%", "ref_range": [10.00, 20.00], "flag": null},
            "PCT": {"value": 0.13, "unit": "%", "ref_range": [0.15, 0.40], "flag": "L"},

            // ESR (СОЭ) — отдельный показатель, часто в других ЛИС
            // идёт отдельным assay, а не частью CBC-панели; уточните,
            // так ли это у вас (может влиять на связку с historical_results).
            "ESR": {"value": 33, "unit": "mm/h", "ref_range": [2.0, 30.00], "flag": "H"},

            "RBC": {"value": 4.56, "unit": "10^12/L", "ref_range": [3.50, 5.20], "flag": null},
            "HGB": {"value": 144.00, "unit": "g/L", "ref_range": [117.00, 160.00], "flag": null},
            "HCT": {"value": 44.70, "unit": "%", "ref_range": [35.00, 47.00], "flag": null}
          },

          // Флаги анализатора (незрелые гранулоциты, подозрение на
          // бласты и т.п. — как IG_present/blast_suspect в исходной
          // схеме проекта). = null, потому что НЕ ПОДТВЕРЖДЕНО, что
          // ваша ЛИС вообще сохраняет такие флаги в структурированном
          // виде (кандидат — autocomment, но это скорее текстовые
          // интерпретационные комментарии по диапазону значения,
          // не флаги морфологии анализатора).
          "instrument_flags": null,
          "instrument_flags_availability": "not_confirmed_in_source_system",

          // Аномальность скаттерограммы. = null по той же причине —
          // не найдено соответствующего поля в дампе схемы; возможно,
          // приходит как часть automate_event.description (свободный
          // текст) — требует проверки на реальных данных.
          "scattergram_abnormal": null,

          "morphology_findings": {
            // "none" — морфологическое исследование не проводилось
            // ЛИБО не заведено в системе как отдельный assay для
            // этого заказа. Нужно уточнить у ИТ-команды, есть ли
            // отдельный assay для пересмотра мазка и как он связан
            // с исходным заказом ОАК (через sample_id?).
            "source": "none",
            "findings_text": null,
            "immature_cell_pct": null
          }
        },

        // Предыдущие результаты этого же пациента по тем же показателям.
        // НЕ хранится в ЛИС как готовый список — строится в витрине
        // (mart.fact_patient_history) агрегацией по
        // patient_pseudo_id + measureparameter_id, отсортированной по
        // collected_at. Пусто в этом кейсе — первый анализ пациента
        // в системе (или более ранние результаты не найдены).
        "historical_results": [],

        // Дельта относительно предыдущего результата. Не хранится в
        // ЛИС явно, считается в витрине. = null, потому что
        // historical_results пуст (не с чем сравнивать). Обратите
        // внимание: method.maxdeviatecoeff в ЛИС — это уже
        // сконфигурированный ПОРОГ допустимого отклонения для
        // дельта-чека, используйте его как референс при расчёте.
        "delta_check": null,

        "rule_based_engine_output": {

          // Числовой код состояния строки заказа из orderline.state
          // ДО расшифровки. = null здесь, потому что расшифровка
          // кодов state не найдена в дампе структуры БД (живёт в
          // коде приложения) — нужно получить словарь кодов отдельно.
          "verdict_raw_state_code": null,

          // Человекочитаемый вердикт ПОСЛЕ трансляции кода state.
          // hold_for_review — заказ остановлен для ручного ревью
          // (аналог orderline.state, соответствующего "на валидации"/
          // "заблокирован", в отличие от completiontimestamp-состояния).
          "verdict": "hold_for_review",

          // Булев флаг orderline.alert — есть ли алерт по строке заказа.
          "alert_flag": true,

          // Текст алерта, СЫРОЙ, как он есть в orderline.alertmessage
          // (или в autocomment) — до нормализации в машиночитаемые теги.
          "alert_message_raw": "PLT/PCT ниже нормы, MPV/СОЭ выше нормы",

          // Нормализованный список сработавших правил в машиночитаемом
          // виде — получен ТРАНСЛЯЦИЕЙ из alert_message_raw/autocomment
          // на этапе ETL, а НЕ пришёл из ЛИС в готовом виде (в ЛИС нет
          // отдельной таблицы "лог сработавших правил" в удобном формате —
          // ближайший аналог, method.validationscript, это код скрипта,
          // не структурированный список).
          "triggered_rules": ["PLT_below_low", "PCT_below_low", "MPV_above_high", "ESR_above_high"],

          // Пояснение для будущего аудита: откуда взялся triggered_rules,
          // и что эта логика ETL ещё не финально провалидирована.
          "rule_source_note": "нормализовано из autocomment/alertmessage на этапе ETL, требует подтверждения соответствия реальному источнику"
        },

        // Псевдонимизированные ссылки на исходные записи ЛИС —
        // нужны для трассируемости при аудите/регуляторной проверке
        // (можно восстановить полный контекст внутри защищённого
        // контура ЛИС по этим id, но сам ML-датасет прямых
        // идентификаторов не содержит).
        "source_refs": {
          "order_id_pseudo": "o_3f8a1c9e",
          "orderline_id_pseudo": "ol_9b2d4e17",
          "sample_id_pseudo": "sm_6a1f0d33"
        }
      }
    },

    // assistant-сообщение — это ВЫХОД, который должна научиться
    // генерировать модель. Сейчас это ЗАГЛУШКА (см. metadata.status
    // ниже) — реальный текст должен прийти от эксперта-верификатора,
    // а не быть сгенерирован автоматически, если кейс идёт в обучение.
    {
      "role": "assistant",
      "content": "Шаг 1 (пороговые значения): PLT 102×10⁹/л (ниже нормы, флаг L), PCT 0.13% (ниже нормы, флаг L), MPV 12.5 fL (выше нормы, флаг H), \n
      СОЭ 33 мм/ч (выше нормы, флаг H). Остальные показатели (WBC, NEUT_abs, RBC, HGB, HCT, MCHC, PDW) в пределах референсных значений.\n
      Шаг 2 (дельта-чек): исторические результаты по данному пациенту отсутствуют, оценить динамику показателей невозможно.\n
      Шаг 3 (флаги анализатора и морфология): наличие флагов анализатора и скаттерограммы в данной ЛИС не подтверждено технически — не путать с отсутствием отклонений. \n 
      Морфологическое исследование не проводилось.\n
      Шаг 4 (соответствие клиническому контексту): клинический диагноз не отслеживается данной ЛИС для амбулаторных заказов ОАК, оценить соответствие отклонений ожидаемой клинической картине невозможно.\n
      Итоговое решение: manual_review.\n
      Обоснование: сочетание умеренной тромбоцитопении, сниженного PCT, повышенного MPV и ускоренной СОЭ может отражать воспалительный процесс,\n
       раннюю стадию гематологического нарушения либо лабораторный артефакт (агрегация тромбоцитов). Без клинического контекста и истории результатов безопасное автоматическое решение невозможно.\n\n
       [ЗАГЛУШКА: требует замены на реальное решение эксперта-верификатора]"
    }
  ],

  // Служебные поля датасета — не подаются модели, используются
  // только вашим ML-пайплайном (фильтрация, аналитика, версионирование).
  "metadata": {

    // Дублирует case_id из user-контента — для быстрого поиска без
    // парсинга вложенного JSON.
    "case_id": "004-058345",

    // Принадлежность к train/validation/test. "unassigned" — кейс
    // ещё не распределён (обычно распределяют ПО ПАЦИЕНТУ, не по
    // отдельному результату — см. нашу более раннюю схему датасета,
    // раздел про split_strategy).
    "split": "unassigned",

    // Теги категорий риска — используются для отдельного контроля
    // false negative rate по узким опасным категориям, а не только
    // общей точности.
    "risk_category_tags": [
      "missing_clinical_context",           // не хватает диагноза для решения
      "thrombocytopenia_unexplained",       // необъяснённая тромбоцитопения
      "source_system_diagnosis_unavailable" // структурное ограничение ЛИС, не факт о пациенте
    ],

    // Явный статус готовности кейса. НЕ "incomplete_pending_expert_review"
    // кейсы должны отфильтровываться перед фактическим обучением —
    // это защита от случайного попадания заглушки в тренировочный сет.
    "status": "incomplete_pending_expert_review",

    // Версия схемы датасета — обязательна, потому что схема эволюционирует
    // (как в этом примере) по мере уточнения реальных возможностей ЛИС.
    // Без версии сложно понять задним числом, по какой логике размечен
    // конкретный старый кейс.
    "schema_version": "v1.1_lis_aligned"
  }
}
